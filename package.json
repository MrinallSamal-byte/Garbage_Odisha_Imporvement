    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@turf/turf": "^7.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^5.6.0",
    "date-fns": "^4.1.0",
    "exifr": "^7.1.3",
    "jose": "^6.0.11",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.511.0",
    "mime-types": "^2.1.35",
    "nanoid": "^5.1.5",
    "next": "15.5.15",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.4",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "supercluster": "^8.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.12"
