{
  "name": "safa-odisha",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run tests/smoke/report-flow.smoke.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "seed:mock": "tsx scripts/seed-mock.ts",
    "seed:representatives": "tsx scripts/seed-representatives.ts",
    "seed:political-mapping": "tsx scripts/seed-political-area-mapping.ts",
    "db:health": "tsx -e \"import { healthCheckDb } from './lib/db/health'; healthCheckDb().then((result) => { console.log(JSON.stringify(result, null, 2)); process.exit(result.ok ? 0 : 1); });\"",
    "import:delhi:boundaries": "tsx scripts/import-delhi-boundaries.ts",
    "import:delhi:parties": "tsx scripts/import-delhi-parties.ts",
    "import:delhi:leaders": "tsx scripts/import-delhi-leaders.ts",
    "import:odisha-boundary": "tsx scripts/import-odisha-boundary.ts",
    "import:assembly": "tsx scripts/import-assembly.ts",
    "import:parliament": "tsx scripts/import-parliament.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1028.0",
